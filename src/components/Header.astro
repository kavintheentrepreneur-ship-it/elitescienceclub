---
export interface Props {
  lang?: 'en' | 'ta';
  surface?: 'showcase' | 'reading';
  translationHref?: string;
}

const { lang = 'en', surface = 'showcase', translationHref } = Astro.props;

const isShowcase = surface === 'showcase';

const navLinks = [
  { href: '/', label: 'Home', labelTa: 'முகப்பு' },
  { href: '/about/', label: 'About', labelTa: 'பற்றி' },
  { href: '/learn/', label: 'Learn', labelTa: 'கற்றல்' },
  { href: '/projects/', label: 'Projects', labelTa: 'திட்டங்கள்' },
  { href: '/media/', label: 'Media', labelTa: 'மீடியா' },
  { href: '/blog/', label: 'Blog', labelTa: 'வலைப்பதிவு' },
  { href: '/contact/', label: 'Contact', labelTa: 'தொடர்பு' },
];

const currentPath = Astro.url.pathname;
// Smart language switcher: use translationHref when available (paired blog posts)
const langToggleHref = translationHref
  ? translationHref
  : lang === 'en'
    ? currentPath.startsWith('/blog/') ? `/ta${currentPath}` : currentPath
    : currentPath.replace(/^\/ta\//, '/');
---

<header class:list={['site-header', { 'header-reading': !isShowcase }]}>
  <nav class="container flex items-center justify-between" aria-label="Main navigation">
    <!-- Logo -->
    <a href="/" class="logo font-display" aria-label="Elite Science Club Home">
      <span class="logo-icon" aria-hidden="true">⚛</span>
      <span class="logo-text">
        <strong>ESC</strong>
        <span class="logo-subtitle">Science For Service</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <ul class="nav-links" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['nav-link', { active: currentPath === link.href }]}
          >
            {lang === 'ta' ? link.labelTa : link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Right Controls -->
    <div class="nav-controls flex items-center gap-sm">
      <!-- Language Toggle -->
      <a
        href={langToggleHref}
        class="lang-toggle"
        aria-label={lang === 'en' ? 'Switch to Tamil' : 'Switch to English'}
        title={lang === 'en' ? 'தமிழ்' : 'English'}
      >
        {lang === 'en' ? 'TA' : 'EN'}
      </a>

      <!-- Mobile Menu Button -->
      <button
        class="mobile-menu-btn"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line class="menu-line menu-line-1" x1="3" y1="6" x2="21" y2="6" />
          <line class="menu-line menu-line-2" x1="3" y1="12" x2="21" y2="12" />
          <line class="menu-line menu-line-3" x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <ul role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['mobile-nav-link', { active: currentPath === link.href }]}
          >
            {lang === 'ta' ? link.labelTa : link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const btn = document.querySelector('.mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      menu.setAttribute('aria-hidden', String(expanded));
      menu.classList.toggle('open');
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0.75rem 0;
    backdrop-filter: blur(12px);
    background: rgba(11, 17, 32, 0.85);
    border-bottom: 1px solid var(--showcase-border);
  }

  .header-reading {
    background: rgba(255, 255, 255, 0.9);
    border-bottom-color: var(--reading-border);
  }

  .header-reading .logo,
  .header-reading .nav-link,
  .header-reading .mobile-menu-btn {
    color: var(--reading-ink);
  }

  .header-reading .nav-link.active,
  .header-reading .nav-link:hover {
    color: var(--accent-cyan);
  }

  .header-reading .lang-toggle {
    border-color: var(--reading-ink);
    color: var(--reading-ink);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  .logo-icon {
    font-size: 1.5rem;
    filter: drop-shadow(0 0 6px rgba(6, 182, 212, 0.5));
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo-text strong {
    font-size: 1.25rem;
    letter-spacing: 0.05em;
  }

  .logo-subtitle {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-cyan);
  }

  /* Desktop Nav */
  .nav-links {
    display: none;
    gap: 0.25rem;
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }
    .mobile-menu-btn {
      display: none;
    }
  }

  .nav-link {
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--accent-cyan);
    background: var(--accent-cyan-muted);
  }

  /* Language Toggle */
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    border: 1px solid var(--text-muted);
    font-size: 0.7rem;
    font-weight: 700;
    font-family: var(--font-display);
    letter-spacing: 0.05em;
    color: var(--text-muted);
    transition: all var(--transition-fast);
  }

  .lang-toggle:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
  }

  /* Mobile Menu Button */
  .mobile-menu-btn {
    color: var(--text-primary);
    padding: 0.25rem;
  }

  @media (min-width: 768px) {
    .mobile-menu-btn { display: none; }
  }

  .menu-line {
    transition: transform var(--transition-base), opacity var(--transition-base);
    transform-origin: center;
  }

  [aria-expanded="true"] .menu-line-1 {
    transform: translateY(6px) rotate(45deg);
  }
  [aria-expanded="true"] .menu-line-2 {
    opacity: 0;
  }
  [aria-expanded="true"] .menu-line-3 {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile Menu Panel */
  .mobile-menu {
    display: none;
    padding: 1rem var(--gutter);
    background: var(--showcase-bg);
    border-bottom: 1px solid var(--showcase-border);
  }

  .header-reading ~ .mobile-menu,
  .mobile-menu.header-reading-child {
    background: var(--reading-bg);
    border-bottom-color: var(--reading-border);
  }

  .mobile-menu.open {
    display: block;
  }

  @media (min-width: 768px) {
    .mobile-menu {
      display: none !important;
    }
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-muted);
    border-bottom: 1px solid var(--showcase-border);
    transition: color var(--transition-fast);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--accent-cyan);
  }
</style>
