---
import ShowcaseLayout from '../../layouts/ShowcaseLayout.astro';
import { getCollection } from 'astro:content';

const siteUrl = 'https://elitescienceclub.org';

const posts = (await getCollection('blog-en'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
  ],
};

const hreflangAlternates = [
  { lang: 'en', href: `${siteUrl}/blog/` },
  { lang: 'ta', href: `${siteUrl}/ta/blog/` },
  { lang: 'x-default', href: `${siteUrl}/blog/` },
];
---

<ShowcaseLayout
  title="Blog — Elite Science Club"
  description="Technical articles on aviation physics, semiconductor science, embedded AI, and ESP32-S3 robotics — by the students of Elite Science Club, Cuddalore."
  hreflangAlternates={hreflangAlternates}
  jsonLd={[breadcrumbLd]}
>
  <!-- Breadcrumb -->
  <nav class="container" style="padding-top: 1.5rem;" aria-label="Breadcrumb">
    <ol class="breadcrumb flex items-center gap-sm font-mono text-sm">
      <li><a href="/" class="text-muted breadcrumb-link">Home</a></li>
      <li class="text-dim" aria-hidden="true">/</li>
      <li class="text-cyan" aria-current="page">Blog</li>
    </ol>
  </nav>

  <section class="section">
    <div class="container">
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <h1 class="font-display" style="font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 0.5rem;">
          <span class="text-cyan">Technical</span> Blog
        </h1>
        <p class="text-muted" style="max-width: 50ch; margin-inline: auto;">
          Deep-dive articles in English. Each post is paired with a companion YouTube Short from
          <a href="https://www.youtube.com/@EliteScienceClub" target="_blank" rel="noopener noreferrer" class="text-cyan">@EliteScienceClub</a>.
        </p>
        <div style="margin-top: 1rem;">
          <a href="/ta/blog/" class="btn btn-outline" style="font-size: 0.8rem;">
            தமிழில் படிக்க →
          </a>
        </div>
      </div>

      {posts.length === 0 && (
        <p class="text-muted" style="text-align: center;">No posts yet. Check back soon!</p>
      )}

      <div class="grid grid-2">
        {posts.map((post) => (\n          <a href={`/blog/${post.id}/`} class="card post-card">
            <div class="flex items-center gap-sm" style="margin-bottom: 0.75rem;">
              <span class="tag">{post.data.category}</span>
              <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs text-dim">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>
            <h2 class="font-display text-lg" style="margin-bottom: 0.5rem; color: var(--text-primary);">
              {post.data.title}
            </h2>
            <p class="text-muted text-sm" style="line-height: 1.6;">
              {post.data.description}
            </p>
            <div class="flex flex-wrap gap-sm" style="margin-top: 0.75rem;">
              {post.data.tags.slice(0, 3).map((tag) => (
                <span class="font-mono text-xs text-dim">#{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</ShowcaseLayout>

<style>
  .breadcrumb-link { transition: color var(--transition-fast); }
  .breadcrumb-link:hover { color: var(--accent-cyan); }
  .post-card { display: block; text-decoration: none; }
  .post-card h2 { transition: color var(--transition-fast); }
  .post-card:hover h2 { color: var(--accent-cyan); }
</style>
