---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import YouTubeFacade from '../../../components/YouTubeFacade.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog-ta');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteUrl = 'https://elitescienceclub.pages.dev';
const canonicalUrl = `${siteUrl}/ta/blog/${post.id}/`;

// Find English translation
const enPosts = await getCollection('blog-en');
const translationSlug = post.data.translationSlug;
const hasTranslation = translationSlug && enPosts.some((p) => p.id === translationSlug);
const translationHref = hasTranslation ? `/blog/${translationSlug}/` : undefined;

// hreflang alternates
const hreflangAlternates = [];
if (hasTranslation) {
  hreflangAlternates.push(
    { lang: 'en', href: `${siteUrl}/blog/${translationSlug}/` },
    { lang: 'ta', href: canonicalUrl },
    { lang: 'x-default', href: `${siteUrl}/blog/${translationSlug}/` },
  );
}

// Reading time (~180 wpm for Tamil)
const wordCount = post.body ? post.body.split(/\s+/).length : 0;
const readingTime = `${Math.max(1, Math.ceil(wordCount / 180))} நிமிடம் படிக்க`;

// JSON-LD: TechArticle
const techArticleLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@id': `${siteUrl}/#organization` },
  publisher: { '@id': `${siteUrl}/#organization` },
  mainEntityOfPage: canonicalUrl,
  inLanguage: 'ta',
  keywords: post.data.tags.join(', '),
};

// Nested VideoObject if real youtubeId is configured (prevents GSC rich snippet errors on placeholder IDs)
if (post.data.youtubeId && !post.data.youtubeId.startsWith('REPLACE_WITH_')) {
  techArticleLd.video = {
    '@type': 'VideoObject',
    name: post.data.title,
    description: post.data.description,
    thumbnailUrl: `https://img.youtube.com/vi/${post.data.youtubeId}/maxresdefault.jpg`,
    uploadDate: post.data.pubDate.toISOString(),
    contentUrl: `https://www.youtube.com/watch?v=${post.data.youtubeId}`,\n    embedUrl: `https://www.youtube-nocookie.com/embed/${post.data.youtubeId}`,\n  };\n}\n\n// BreadcrumbList\nconst breadcrumbLd = {\n  '@context': 'https://schema.org',\n  '@type': 'BreadcrumbList',\n  itemListElement: [\n    { '@type': 'ListItem', position: 1, name: 'முகப்பு', item: siteUrl },\n    { '@type': 'ListItem', position: 2, name: 'வலைப்பதிவு', item: `${siteUrl}/ta/blog/` },\n    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonicalUrl },\n  ],\n};\n---\n\n<BlogLayout\n  title={post.data.title}\n  description={post.data.description}\n  canonical={canonicalUrl}\n  lang=\"ta\"\n  hreflangAlternates={hreflangAlternates}\n  jsonLd={[techArticleLd, breadcrumbLd]}\n  pubDate={post.data.pubDate.toISOString()}\n  readingTime={readingTime}\n  tags={post.data.tags}\n  category={post.data.category}\n  translationHref={translationHref}\n>\n  <h1 class=\"tamil-text\">{post.data.title}</h1>\n\n  {/* Companion YouTube Video Facade */}\n  {post.data.youtubeId && (\n    <div style=\"margin-block: 1.5em;\">\n      <YouTubeFacade videoId={post.data.youtubeId} title={post.data.title} />\n      <p style=\"text-align: center; margin-top: 0.5rem;\">\n        <a\n          href={`https://www.youtube.com/watch?v=${post.data.youtubeId}`}\n          target=\"_blank\"\n          rel=\"noopener noreferrer\"\n          style=\"font-size: 0.8rem; color: var(--reading-ink-dim);\"\n        >\n          YouTube-இல் பாருங்கள் →\n        </a>\n      </p>\n    </div>\n  )}\n\n  <Content />\n\n  {/* Translation link */}\n  {hasTranslation && (\n    <aside class=\"translation-banner\">\n      <p>\n        🌐 Read this article in English:\n        <a href={`/blog/${translationSlug}/`}>English Version →</a>\n      </p>\n    </aside>\n  )}\n</BlogLayout>\n\n<style>\n  .translation-banner {\n    margin-top: 2rem;\n    padding: 1rem 1.25rem;\n    background: #F0FDFA;\n    border: 1px solid #99F6E4;\n    border-radius: var(--radius);\n    font-size: 0.95rem;\n  }\n\n  .translation-banner a {\n    color: var(--accent-cyan);\n    font-weight: 600;\n  }\n</style>\n