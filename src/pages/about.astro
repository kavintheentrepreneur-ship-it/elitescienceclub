---
import ShowcaseLayout from '../layouts/ShowcaseLayout.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';

const siteUrl = 'https://elitescienceclub.org';

const aboutPageLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${siteUrl}/about/#aboutpage`,
  name: 'About Elite Science Club',
  description: 'Learn about Elite Science Club (ESC) — a student-led STEM initiative from Cuddalore, Tamil Nadu, India, dedicated to open-source science education.',
  url: `${siteUrl}/about/`,
  mainEntity: { '@id': `${siteUrl}/#organization` },
  video: {
    '@type': 'VideoObject',
    name: 'What Is Elite Science Club? Official Intro | Cuddalore, Tamil Nadu',
    description: 'Official introduction to Elite Science Club — student-led science communication from Cuddalore.',
    thumbnailUrl: 'https://img.youtube.com/vi/fVsOmF73o-A/maxresdefault.jpg',
    uploadDate: '2026-10-09T00:00:00Z',
    duration: 'PT11S',
    contentUrl: 'https://www.youtube.com/watch?v=fVsOmF73o-A',
    embedUrl: 'https://www.youtube-nocookie.com/embed/fVsOmF73o-A',
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [\n    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'About', item: `${siteUrl}/about/` },
  ],
};

const teamRoles = [
  {
    role: 'Founder & Lead',
    icon: '🔬',
    description: 'Drives the club\'s vision, coordinates projects, and ensures every initiative stays true to "Science For Service."',
  },
  {
    role: 'Hardware & Robotics Lead',
    icon: '🤖',
    description: 'Architects ESP32-S3 AI robotics builds, manages hardware procurement, and documents BOM/wiring for reproducible open-source projects.',
  },
  {
    role: 'Media & 2.5D Animation Lead',
    icon: '🎬',
    description: 'Produces 4K 2.5D YouTube Shorts and 16:9 explainers for @EliteScienceClub, handling storyboarding, motion graphics, and post-production.',
  },
  {
    role: 'Content & Blog Lead',
    icon: '📝',
    description: 'Authors bilingual (English & Tamil) technical articles, manages the editorial calendar, and ensures SEO-optimized companion blog posts for every video.',
  },
  {
    role: 'Outreach & Collaboration Lead',
    icon: '🤝',
    description: 'Manages partnerships with schools and STEM organizations, coordinates workshops, and handles community engagement across Cuddalore.',
  },
];

const milestones = [
  { year: '2024', event: 'Elite Science Club founded in Cuddalore, Tamil Nadu' },
  { year: '2024', event: 'Launched @EliteScienceClub YouTube channel with 4K 2.5D Shorts' },
  { year: '2024', event: 'First ESP32-S3 AI Robotics build documented and open-sourced' },
  { year: '2025', event: 'Bilingual blog engine launched — English & Tamil technical articles' },
  { year: '2025', event: 'Project Footprinting initiative established for Entity SEO' },
];
---

<ShowcaseLayout
  title="About ESC — Our Mission & Team"
  description="Elite Science Club (ESC) is a student-led STEM initiative from Cuddalore, Tamil Nadu. Learn about our open-source philosophy, team structure, and commitment to Science For Service."
  jsonLd={[aboutPageLd, breadcrumbLd]}
>
  <!-- Breadcrumb -->
  <nav class="container" style="padding-top: 1.5rem;" aria-label="Breadcrumb">
    <ol class="breadcrumb flex items-center gap-sm font-mono text-sm">
      <li><a href="/" class="text-muted breadcrumb-link">Home</a></li>
      <li class="text-dim" aria-hidden="true">/</li>
      <li class="text-cyan" aria-current="page">About</li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="section" style="padding-bottom: 2rem;">
    <div class="container" style="text-align: center;">
      <p class="font-mono text-sm text-cyan" style="margin-bottom: 0.75rem;">📍 Cuddalore, Tamil Nadu, India</p>
      <h1 class="font-display" style="font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 1rem;">
        About <span class="text-cyan">Elite Science Club</span>
      </h1>
      <p class="text-muted" style="max-width: 60ch; margin-inline: auto; font-size: 1.05rem; line-height: 1.7;">
        We are a student-led STEM initiative dedicated to making science accessible, visual, and multilingual.
        Through 4K YouTube Shorts, bilingual technical blogs, and hands-on ESP32-S3 AI robotics projects,
        we prove that world-class science communication can come from anywhere.
      </p>
    </div>
  </section>

  <!-- Official Intro Video Spotlight -->
  <section class="section" style="padding-top: 0; padding-bottom: 2.5rem;">
    <div class="container" style="max-width: 440px; text-align: center;">
      <div class="card" style="padding: 1.5rem;">
        <div class="flex items-center justify-between" style="margin-bottom: 0.75rem;">
          <span class="tag tag-cyan font-mono">Official Video Intro</span>
          <span class="font-mono text-xs text-dim">@EliteScienceClub</span>
        </div>
        <YouTubeFacade
          videoId="fVsOmF73o-A"
          title="What Is Elite Science Club? Official Intro | Cuddalore, Tamil Nadu"
          aspect="9:16"
        />
        <h2 class="font-display text-base text-primary" style="margin-top: 1rem; margin-bottom: 0.25rem;">
          What Is Elite Science Club?
        </h2>
        <p class="text-muted text-xs">
          Official Intro from our student leads in Cuddalore, Tamil Nadu.
        </p>
      </div>
    </div>
  </section>

  <!-- Mission & Philosophy -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="grid grid-2" style="gap: 2rem; align-items: start;">
        <div class="card">
          <h2 class="font-display text-xl" style="margin-bottom: 1rem;">
            <span class="text-cyan">Our</span> Mission
          </h2>
          <p class="text-muted" style="line-height: 1.7; margin-bottom: 1rem;">
            <strong class="text-primary" style="color: var(--text-primary);">Science For Service</strong> —
            our motto captures everything we do. We believe the best science isn't locked behind
            paywalls or jargon. It belongs to everyone.
          </p>
          <ul style="display: flex; flex-direction: column; gap: 0.75rem;">
            <li class="flex items-center gap-sm text-muted">
              <span class="text-cyan">▸</span> Translate complex STEM topics into visual, 60-second explainers
            </li>
            <li class="flex items-center gap-sm text-muted">
              <span class="text-cyan">▸</span> Publish every article in both English and Tamil
            </li>
            <li class="flex items-center gap-sm text-muted">
              <span class="text-cyan">▸</span> Open-source all hardware projects with full BOM and schematics
            </li>
            <li class="flex items-center gap-sm text-muted">
              <span class="text-cyan">▸</span> Bridge the gap between rural STEM talent and global knowledge
            </li>
          </ul>
        </div>

        <div class="card">
          <h2 class="font-display text-xl" style="margin-bottom: 1rem;">
            <span class="text-violet">Open-Source</span> Philosophy
          </h2>
          <p class="text-muted" style="line-height: 1.7; margin-bottom: 1rem;">
            Every project we build is documented and shared openly. From our ESP32-S3 AI robotics
            schematics to our blog's codebase, we believe in radical transparency.
          </p>
          <p class="text-muted" style="line-height: 1.7; margin-bottom: 1rem;">
            Our content pipeline pairs every YouTube Short and 16:9 explainer with a companion
            technical blog post — creating a searchable, linkable knowledge base that serves
            students, teachers, and lifelong learners alike.
          </p>
          <p class="text-muted" style="line-height: 1.7;">
            We use modern web technologies (Astro, TypeScript, SSG) for our website because
            we practice what we preach: performance, accessibility, and clean engineering.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Roles -->
  <section class="section">
    <div class="container">
      <h2 class="font-display text-2xl" style="text-align: center; margin-bottom: 0.5rem;">
        <span class="text-cyan">Student</span> Leadership
      </h2>
      <p class="text-muted text-sm" style="text-align: center; margin-bottom: 2rem; max-width: 50ch; margin-inline: auto;">
        ESC is entirely student-run. Each leadership role carries real responsibility and real output.
      </p>
      <div class="grid grid-3">
        {teamRoles.map((member) => (
          <div class="card" style="text-align: center;">
            <div style="font-size: 2rem; margin-bottom: 0.75rem;">{member.icon}</div>
            <h3 class="font-display text-lg" style="margin-bottom: 0.5rem; color: var(--text-primary);">
              {member.role}
            </h3>
            <p class="text-muted text-sm" style="line-height: 1.6;">
              {member.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section">
    <div class="container" style="max-width: 700px;">
      <h2 class="font-display text-2xl" style="text-align: center; margin-bottom: 2rem;">
        <span class="text-violet">Our</span> Journey
      </h2>
      <div class="timeline">
        {milestones.map((m, i) => (
          <div class="timeline-item flex gap-md">
            <div class="timeline-marker">
              <span class="font-mono text-xs text-cyan">{m.year}</span>
              <div class="timeline-dot" />
              {i < milestones.length - 1 && <div class="timeline-line" />}
            </div>
            <div style="padding-bottom: 2rem;">
              <p class="text-muted" style="line-height: 1.6;">{m.event}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Verified External Links -->
  <section class="section" style="padding-bottom: 4rem;">
    <div class="container" style="text-align: center;">
      <h2 class="font-display text-xl" style="margin-bottom: 1.5rem;">
        <span class="text-cyan">Official</span> Links
      </h2>
      <div class="flex justify-center flex-wrap gap-md">
        <a
          href="https://www.youtube.com/@EliteScienceClub"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          ▶ YouTube @EliteScienceClub
        </a>
        <a href="/contact/" class="btn btn-outline">
          📧 Get In Touch
        </a>
      </div>
    </div>
  </section>
</ShowcaseLayout>

<style>
  .breadcrumb-link {
    transition: color var(--transition-fast);
  }
  .breadcrumb-link:hover {
    color: var(--accent-cyan);
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 3.5rem;
    gap: 0.5rem;
  }

  .timeline-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 8px rgba(6, 182, 212, 0.4);
    flex-shrink: 0;
  }

  .timeline-line {
    width: 2px;
    flex: 1;
    background: var(--showcase-border);
    min-height: 2rem;
  }
</style>
