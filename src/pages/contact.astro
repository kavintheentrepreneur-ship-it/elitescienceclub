---
import ShowcaseLayout from '../layouts/ShowcaseLayout.astro';

const siteUrl = 'https://elitescienceclub.pages.dev';

const contactPageLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${siteUrl}/contact/#contactpage`,
  name: 'Contact Elite Science Club',
  description: 'Reach out for collaborations, workshop inquiries, or media partnerships with Elite Science Club, Cuddalore, Tamil Nadu.',
  url: `${siteUrl}/contact/`,
  mainEntity: { '@id': `${siteUrl}/#organization` },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: `${siteUrl}/contact/` },
  ],
};

const collaborationTypes = [
  {
    icon: '🏫',
    title: 'School & College Workshops',
    description: 'Invite ESC to conduct hands-on STEM workshops — from aviation physics demos to ESP32-S3 robotics build sessions. We bring all hardware and curriculum.',
  },
  {
    icon: '🎙️',
    title: 'Speaking & Panel Discussions',
    description: 'Our student leads are available for science communication panels, TEDx-style talks, and STEM career guidance sessions across Tamil Nadu.',
  },
  {
    icon: '🤝',
    title: 'Content Collaborations',
    description: 'Co-produce YouTube Shorts, cross-publish bilingual blog articles, or partner on a hardware project. We love building with other STEM creators.',
  },
  {
    icon: '🏢',
    title: 'Sponsorships & Grants',
    description: 'Help us scale our open-source STEM initiatives. Sponsorships fund hardware kits for students and production equipment for higher-quality explainers.',
  },
];
---

<ShowcaseLayout
  title="Contact & Collaborate — Elite Science Club"
  description="Reach out to Elite Science Club for STEM workshop bookings, speaking invitations, content collaborations, or sponsorship opportunities. Based in Cuddalore, Tamil Nadu."
  jsonLd={[contactPageLd, breadcrumbLd]}
>
  <!-- Breadcrumb -->
  <nav class="container" style="padding-top: 1.5rem;" aria-label="Breadcrumb">
    <ol class="breadcrumb flex items-center gap-sm font-mono text-sm">
      <li><a href="/" class="text-muted breadcrumb-link">Home</a></li>
      <li class="text-dim" aria-hidden="true">/</li>
      <li class="text-cyan" aria-current="page">Contact</li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="section" style="padding-bottom: 2rem;">
    <div class="container" style="text-align: center;">
      <h1 class="font-display" style="font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 1rem;">
        <span class="text-cyan">Contact</span> & Collaborate
      </h1>
      <p class="text-muted" style="max-width: 55ch; margin-inline: auto; font-size: 1.05rem; line-height: 1.7;">
        Whether you're a school looking for a STEM workshop, a creator seeking a collaboration partner,
        or an organization interested in sponsoring open-source science education — we'd love to hear from you.
      </p>
    </div>
  </section>

  <!-- Primary Contact -->
  <section class="section" style="padding-top: 0;">
    <div class="container" style="max-width: 700px;">
      <div class="card contact-hero-card" style="text-align: center; padding: 2.5rem;">
        <div style="font-size: 2.5rem; margin-bottom: 1rem;">📧</div>
        <h2 class="font-display text-xl" style="margin-bottom: 0.5rem;">
          Get In Touch
        </h2>
        <p class="text-muted" style="margin-bottom: 1.5rem; line-height: 1.6;">
          For all inquiries — workshops, collaborations, media, or general questions:
        </p>
        <a href="mailto:contact@elitescienceclub.org" class="contact-email font-mono text-lg">
          contact@elitescienceclub.org
        </a>
        <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--showcase-border);">
          <p class="font-mono text-xs text-muted" style="margin-bottom: 0.25rem;">📍 Based in</p>
          <p class="font-display" style="color: var(--text-primary);">Cuddalore, Tamil Nadu, India</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Collaboration Types -->
  <section class="section">
    <div class="container">
      <h2 class="font-display text-2xl" style="text-align: center; margin-bottom: 0.5rem;">
        Ways to <span class="text-cyan">Collaborate</span>
      </h2>
      <p class="text-muted text-sm" style="text-align: center; margin-bottom: 2rem; max-width: 50ch; margin-inline: auto;">
        We're open to partnerships that align with our mission of accessible, multilingual STEM education.
      </p>
      <div class="grid grid-2">
        {collaborationTypes.map((collab) => (
          <div class="card">
            <div style="font-size: 1.75rem; margin-bottom: 0.75rem;">{collab.icon}</div>
            <h3 class="font-display text-lg" style="margin-bottom: 0.5rem; color: var(--text-primary);">
              {collab.title}
            </h3>
            <p class="text-muted text-sm" style="line-height: 1.6;">
              {collab.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Official Channels -->
  <section class="section" style="padding-bottom: 4rem;">
    <div class="container" style="text-align: center;">
      <h2 class="font-display text-xl" style="margin-bottom: 0.5rem;">
        <span class="text-violet">Official</span> Channels
      </h2>
      <p class="text-muted text-sm" style="margin-bottom: 1.5rem;">
        Connect with us on our verified platforms.
      </p>
      <div class="flex justify-center flex-wrap gap-md">
        <a
          href="https://www.youtube.com/@EliteScienceClub"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          ▶ YouTube @EliteScienceClub
        </a>
        <a href="mailto:contact@elitescienceclub.org" class="btn btn-outline">
          📧 Email Us
        </a>
      </div>
      <p class="font-mono text-xs text-dim" style="margin-top: 1.5rem;">
        Response time: typically within 48 hours
      </p>
    </div>
  </section>
</ShowcaseLayout>

<style>
  .breadcrumb-link {
    transition: color var(--transition-fast);
  }
  .breadcrumb-link:hover {
    color: var(--accent-cyan);
  }

  .contact-hero-card {
    border-color: var(--accent-cyan);
    box-shadow: var(--shadow-glow-cyan);
  }

  .contact-email {
    display: inline-block;
    color: var(--accent-cyan);
    text-decoration: none;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--accent-cyan);
    border-radius: var(--radius);
    transition: all var(--transition-fast);
  }

  .contact-email:hover {
    background: var(--accent-cyan-muted);
    box-shadow: var(--shadow-glow-cyan);
  }
</style>
