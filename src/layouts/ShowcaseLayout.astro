---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  lang?: 'en' | 'ta';
  hreflangAlternates?: { lang: string; href: string }[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, canonical, ogImage, lang = 'en', hreflangAlternates, jsonLd, noindex = false } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      lang={lang}
      hreflangAlternates={hreflangAlternates}
      jsonLd={jsonLd}
      noindex={noindex}
    />
  </head>
  <body class="surface-showcase">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header lang={lang} surface="showcase" />
    <main id="main-content">
      <slot />
    </main>
    <Footer surface="showcase" />
  </body>
</html>
